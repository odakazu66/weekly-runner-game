{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weekly-runner/params/difficulty.schema.json",
  "title": "difficulty",
  "type": "object",
  "additionalProperties": false,
  "required": ["curve"],
  "properties": {
    "curve": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["distance", "speed", "density"],
        "properties": {
          "distance": { "type": "number", "minimum": 0, "maximum": 1000000 },
          "speed": { "type": "number", "minimum": 1, "maximum": 9 },
          "density": { "type": "number", "minimum": 0.5, "maximum": 3 }
        }
      }
    }
  }
}
